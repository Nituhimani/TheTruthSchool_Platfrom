{
  "name": "thetruthschool-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "TheTruthSchool - AI-powered career development platform",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "biome lint ./apps ./packages",
    "lint:fix": "biome lint --apply ./apps ./packages",
    "format": "biome format --write ./apps ./packages",
    "format:check": "biome format ./apps ./packages",
    "check": "biome check ./apps ./packages",
    "check:fix": "biome check --apply ./apps ./packages",
    "type-check": "turbo run type-check",
    "test": "turbo run test",
    "clean": "turbo run clean && rm -rf node_modules",
    "prepare": "husky install",
    "setup:git": "./tools/scripts/git-setup.sh"
  },
  "devDependencies": {
    "@biomejs/biome": "1.4.1",
    "@changesets/cli": "^2.27.1",
    "@turbo/gen": "^1.10.12",
    "lint-staged": "^15.2.0",
    "rimraf": "^5.0.5",
    "turbo": "latest",
    "typescript": "^5.3.3"
  },
  "packageManager": "pnpm@8.10.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,md}": [
      "biome check --apply --no-errors-on-unmatched"
    ]
  }
}