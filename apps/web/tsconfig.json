{
  "extends": "@thetruthschool/tsconfig/nextjs.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@thetruthschool/ui": [
        "../packages/ui/src/index.ts"
      ],
      "@thetruthschool/ui/*": [
        "../packages/ui/src/*"
      ],
      "@thetruthschool/shared-types": [
        "../packages/shared-types/src/index.ts"
      ]
    },
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}