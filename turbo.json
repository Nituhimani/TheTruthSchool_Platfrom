{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    "**/.env.*local",
    "**/.env",
    ".env",
    ".env.local"
  ],
  "globalEnv": [
    "NODE_ENV",
    "DATABASE_URL",
    "NEXTAUTH_SECRET",
    "NEXTAUTH_URL",
    "GOOGLE_CLIENT_ID",
    "GOOGLE_CLIENT_SECRET",
    "OPENAI_API_KEY",
    "LIVEKIT_API_KEY",
    "LIVEKIT_API_SECRET"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": [
        "src/**/*",
        "app/**/*",
        "pages/**/*",
        "components/**/*",
        "lib/**/*",
        "styles/**/*",
        "public/**/*",
        "package.json",
        "tsconfig.json",
        "next.config.js",
        "tailwind.config.js"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "dist/**",
        "build/**"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "inputs": [
        "src/**/*",
        "app/**/*",
        "**/*.{js,jsx,ts,tsx,json}",
        "biome.json"
      ]
    },
    "format": {
      "inputs": [
        "src/**/*",
        "app/**/*",
        "**/*.{js,jsx,ts,tsx,json,md}"
      ],
      "cache": false
    },
    "check": {
      "inputs": [
        "src/**/*",
        "app/**/*",
        "**/*.{js,jsx,ts,tsx,json,md}",
        "biome.json"
      ],
      "cache": false
    },
    "type-check": {
      "dependsOn": ["^build"],
      "inputs": [
        "src/**/*",
        "app/**/*",
        "tsconfig.json",
        "package.json"
      ]
    },
    "clean": {
      "cache": false
    }
  }
}